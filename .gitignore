# ============================================
# PMA Backend - Git Ignore Rules
# Sensitive Files (NEVER commit these!)
# ============================================

# Environment & Configuration
.env
.env.*.php
.env.backup
.env.local
.env.production
.env.testing

# Secrets & Keys
/storage/*.key
/storage/keys
/bootstrap/cache/.gitkeep
auth.json

# Dependency directories
/vendor
/node_modules
/package-lock.json
/composer.lock

# Build artifacts
/public/build
/public/hot
/public/fonts-manifest.dev.json
/public/storage

# IDE & Editor Settings
.vscode
.idea
.cursor
.nova
.phpactor.json
_ide_helper.php
*.swp
*.swo
*~
.DS_Store

# Testing
.phpunit.result.cache
.phpunit.cache
/.codex

# Temporary files
*.tmp
*.temp
Thumbs.db
Homestead.json
Homestead.yaml

# Logs (local development)
*.log
/storage/logs/*.log
storage/pail

# User-specific files
.env.*.local
.env.*.user

# Firebase credentials
firebase-service-account.json
firebase-*.json

# API tokens & credentials
.tokens
tokens.json
credentials.json
secrets/

# Compiled PHP
*.php.cache

# OS files
.DS_Store
.AppleDouble
.LSOverride
.windows-thumbnail.db
